# ============ 应用 ============
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# ============ MySQL（Docker 映射 3307，本机原生 MySQL 占用 3306）============
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=yunshu
MYSQL_PASSWORD=yunshu_change_me
MYSQL_DATABASE=yunshu

# ============ Redis ============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis_change_me
REDIS_DB=0

# ============ MinIO（本地开发对象存储；上线切阿里云 OSS，见 OSS_*）============
# 宿主端口为 19000（9000 可能被 Windows 保留段占用），容器内仍为 9000
MINIO_ENDPOINT=127.0.0.1:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio_change_me
MINIO_BUCKET=yunshu
MINIO_SECURE=false
# 对象存储后端：minio（本地开发）| oss（线上，填下方 OSS_* 后切换）
STORAGE_BACKEND=minio
# 单文件上传上限（MB）；nginx 的 client_max_body_size 设为 12m 留 multipart 余量
UPLOAD_MAX_MB=10

# ============ Milvus 向量库 ============
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# 两个向量集合：公共面试资料库 / 个人简历库（数据隔离，同一套切片逻辑）
MILVUS_COLLECTION_DOCS=interview_doc_snippets
MILVUS_COLLECTION_RESUME=resume_snippets

# ============ 业务参数（集中管理，改这里即可）============
# 每天最多发起几次面试、单场时长（分钟）
INTERVIEW_DAILY_LIMIT=3
INTERVIEW_MINUTES=15
# 验证码：同号重发间隔（秒）、单日上限（条）
SMS_RESEND_SECONDS=60
SMS_DAILY_LIMIT=10
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ============ JWT ============
# 32 位随机十六进制；生成方式：openssl rand -hex 16 或 [guid]::NewGuid().ToString('N')
JWT_SECRET=change_me_to_32_hex_chars
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# ============ 管理端账号 ============
# 改完跑 scripts/reset_admin_password.py 生效；留空则跳过重置
ADMIN_USERNAME=admin
ADMIN_INIT_PASSWORD=

# ================================================================
#  第三方 API KEY（以下留空，按需填写真实值）
# ================================================================

# ---------- 大模型：DeepSeek 4.1 Flash（OpenAI 兼容协议）----------
# 用途：面试出题、追问、简答判分、点评（共 4 处调用）
# 申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 可选：deepseek-flash（快、便宜，判分够用）/ deepseek-v4-pro（更强）
DEEPSEEK_MODEL=deepseek-flash

# ---------- Embedding：qwen3.7-text-embedding（阿里云百炼 / DashScope）----------
# 用途：切片与查询的稠密向量；稀疏向量由 Milvus 内置 BM25 从原文生成，不需要额外模型
# 申请：https://bailian.console.aliyun.com → API-KEY
DASHSCOPE_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
# 必须与 Milvus 集合维度一致，且入库与查询两侧必须相同
EMBEDDING_DIM=1024

# ---------- 阿里云 AccessKey（OSS 与短信共用同一对；也可拆成两个 RAM 子账号后分填）----------
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# ---------- 阿里云 OSS：简历与面试资料原文件 ----------
# 地域需与 endpoint 匹配，例如杭州填 oss-cn-hangzhou
OSS_ENDPOINT=
OSS_BUCKET=

# ---------- 阿里云号码认证服务：注册验证码（测试手机号码）----------
# 通道：dypnsapi（SendSmsVerifyCode / CheckSmsVerifyCode）
# 真实下发到测试号码、不计费；项目全程使用该通道，不切真实计费通道
# 模板变量 ${code} 与 ${min} 均需调用方传入（阿里云不会自动填充）
#   ${code}：服务端生成 6 位随机码并写入 Redis，注册时本地校验后立即删除
#   ${min}：取 ALIYUN_PNVS_VALID_MINUTES
ALIYUN_PNVS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_PNVS_SIGN_NAME=
ALIYUN_PNVS_TEMPLATE_CODE=
# 方案名：短信验证码场景可留空（走默认方案），一键登录才需要
ALIYUN_PNVS_SCHEME_NAME=
# 验证码位数与有效期（分钟）
ALIYUN_PNVS_CODE_LENGTH=6
ALIYUN_PNVS_VALID_MINUTES=5
# 测试号码白名单（逗号分隔），必须与控制台的「测试手机号码」完全一致
# 注意：每个账号最多授权 5 个测试号码
AUTH_TEST_PHONES=

# ---------- 腾讯云语音：实时识别（ASR）+ 语音合成（TTS）----------
# 开通后务必到控制台手动【领取】免费资源包，否则直接按量计费：
#   ASR 每月 5 小时（每月刷新） / TTS 800 万字符（领取后 3 个月内有效）
# 注意：ASR 必须选「实时语音识别（基础版）」，带"大模型 2.0 版"字样的没有免费额度
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 账号 APPID（右上角「账号信息」→ APPID，10 位数字）
# 新版控制台没有单独的「应用管理」，语音服务直接用账号 APPID
TENCENT_APP_ID=
# 实时识别引擎：16k_zh = 中文普通话 + 16k 采样率
TENCENT_ASR_ENGINE_MODEL=16k_zh
TENCENT_ASR_WS_URL=wss://asr.cloud.tencent.com/asr/v2
# 语音合成音色 ID：可留空，代码默认 101001（标准女声）；试听在控制台「体验中心」
TENCENT_TTS_VOICE_TYPE=
TENCENT_TTS_CODEC=mp3

# ---------- MinerU：PDF → Markdown ----------
# 走云端解析服务时填；若本地起 MinerU 容器，两项可留空
MINERU_API_URL=
MINERU_API_KEY=

# ============ 跨域：两个前端工程本地开发端口 ============
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
