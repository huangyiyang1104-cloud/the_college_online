# ================================================================
#  docker compose 专用变量模板：只放基础设施与端口
#
#  用法：cp .env.example .env
#  应用密钥（JWT / 模型 / 阿里云 / 腾讯云等）统一放在 backend/.env，
#  compose 里 api、worker 通过 env_file: ../backend/.env 注入。
# ================================================================

TZ=Asia/Shanghai

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root_change_me
MYSQL_DATABASE=yunshu
MYSQL_USER=yunshu
MYSQL_PASSWORD=yunshu_change_me
# 宿主端口：本机若已装 MySQL 占用 3306，容器映射到 3307（容器内始终是 3306）
MYSQL_PORT=3307

# ---------- Redis ----------
REDIS_PASSWORD=redis_change_me
REDIS_PORT=6379

# ---------- MinIO（Milvus 依赖 + 本地对象存储）----------
MINIO_IMAGE=bitnamilegacy/minio:latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_change_me
MINIO_BUCKET=yunshu
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Milvus ----------
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.16
MILVUS_IMAGE=milvusdb/milvus:v2.5.4
MILVUS_PORT=19530
# 9091 可能落入 Windows Hyper-V 保留端口段，冲突时改为 19091
MILVUS_METRICS_PORT=19091

# ---------- 管理端 Basic Auth（nginx 第二道门）----------
# 填好后执行 python gen_htpasswd.py 生成 .htpasswd，再重启 nginx
NGINX_BASIC_AUTH_USER=admin
NGINX_BASIC_AUTH_PASSWORD=

# ---------- 服务端口 ----------
API_PORT=8000
NGINX_PORT=80
ATTU_IMAGE=zilliz/attu:v2.5
ATTU_PORT=3000
